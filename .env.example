# Server-only. Use Vercel Project Settings for deployments; never add a VITE_ prefix.
GEMINI_API_KEY=
# Compatibility alias; GEMINI_API_KEY takes precedence when nonblank.
Gemini_LLM_API_Key=
GEMINI_MODEL=gemini-2.5-flash
# Random access code, at least 24 characters.
DEMO_ACCESS_CODE=
# Independent random signing secret, at least 32 characters.
SESSION_SECRET=
